#@ bench/host/prologue.sh.in: a template `<game> bench` fills, first the text
#@ blinx2-recomp's scripts/bench.sh expanded. The #@ lines this file starts
#@ with are this note and are not sent. It is the remote_vars prologue every script after it starts with. @NAME@ is
#@ filled with the configured value, unquoted on purpose: ~ expands on the host.
#@ The game's own values after them (game.toml; paths relative to
#@ REMOTE_GAME) come shell-quoted: a game files folder may hold a space.
set -euo pipefail
BENCH_DIR=@BENCH_DIR@
REMOTE_GAME=@REMOTE_GAME@
LLVM_MINGW_ROOT=@LLVM_MINGW_ROOT@
BENCH_PREFIX=@BENCH_PREFIX@
BENCH_BOX='@BENCH_BOX@'
SLUG=@SLUG@
EXE=@EXE@
EXE_REL=@EXE_REL@
GEN_DIR=@GEN_DIR@
GAME_FILES=@GAME_FILES@
XBE=@XBE@
CLI_DIR=$BENCH_DIR/xboxrecomp-cli
TOOLCHAIN=@TOOLCHAIN@
CRASH_TAG=@CRASH_TAG@
