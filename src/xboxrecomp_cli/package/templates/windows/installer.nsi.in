; The installer, rendered by `<game> package windows` into
; dist/.stage-windows/installer.nsi and compiled with makensis.
;
; Per user, no elevation. The program files are embedded; game_files\ is
; copied from the folder setup.exe runs in (NSIS caps an installer at 2 GB,
; and the dump alone is larger).
;
; The versioned layout (D8): the program files go to versions\<version>\,
; the game files stay unversioned in game_files\, and current.txt names
; the version the root stub runs. NSIS cannot hard-link, flush or replace
; a file in one write-through move, so it extracts apply.exe first and
; calls it: "migrate" moves an older in-place install into versions\,
; "switch" makes the extracted versions\<version>.partial current. Saves and settings live in
; the data folder (game.toml's data.windows), which neither the installer nor the uninstaller
; ever changes: installing on top or uninstalling keeps them. The one write
; there is a bundle's config.seed.toml (package --seed-config), copied to
; config\config.toml when that file does not exist yet.
;
; Placeholders (each written between @ signs): NAME LINK_NAME APP DATA_DIR
; VERSION OUTFILE ICON INSTALL_FILES UNINSTALL_FILES GAME_FILES_KB APPLY
; STUB. Never
; write one in a comment: it is replaced there too.

Unicode true
SetCompressor zlib
RequestExecutionLevel user
ManifestDPIAware true

!define APP "@APP@"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP@"
!define PART "$INSTDIR\versions\@VERSION@.partial"

Name "@NAME@"
OutFile "@OUTFILE@"
InstallDir "$LOCALAPPDATA\Programs\@APP@"
InstallDirRegKey HKCU "Software\@APP@" "InstallDir"
ShowInstDetails show
ShowUninstDetails show

!include "MUI2.nsh"
!include "LogicLib.nsh"
; The game's icon (or the generic one) on the installer and uninstaller.
!define MUI_ICON "@ICON@"
!define MUI_UNICON "@ICON@"
!define MUI_FINISHPAGE_RUN "$INSTDIR\@APP@.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Play @NAME@"
; Each path on its own line: a label wraps only at spaces, which a path may lack.
!define MUI_FINISHPAGE_TEXT "@NAME@ @VERSION@ is installed in:$\r$\n$INSTDIR$\r$\n$\r$\nYour saves and settings are kept in:$\r$\n$LOCALAPPDATA\@DATA_DIR@$\r$\nUpdates and uninstalling keep them.$\r$\n$\r$\nPRIVATE: the install folder holds your own copy of the game. Do not share it."
!define MUI_FINISHPAGE_TEXT_LARGE
; The installer never asks for a reboot, and FinishShow's taller label would
; cover the reboot radio buttons if it did.
!define MUI_FINISHPAGE_NOREBOOTSUPPORT
!insertmacro MUI_PAGE_WELCOME
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE DirLeave
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
; Defined here, not with the finish text: a page takes the CUSTOMFUNCTION
; defines made before it, so earlier it would go to the welcome page.
!define MUI_PAGE_CUSTOMFUNCTION_SHOW FinishShow
!insertmacro MUI_PAGE_FINISH
!define MUI_UNFINISHPAGE_NOAUTOCLOSE
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  IfFileExists "$EXEDIR\game_files\default.xbe" +3
    MessageBox MB_ICONSTOP "game_files\default.xbe is missing beside this setup program.$\r$\nKeep the @APP@-@VERSION@-windows folder together and run setup from it." /SD IDOK
    Abort
  ; /S skips the directory page, so check here too.
  ${If} ${Silent}
    Call CheckInstDir
  ${EndIf}
FunctionEnd

; The install replaces $INSTDIR\game_files (RMDir /r, then a copy from
; $EXEDIR\game_files): installing into the bundle folder, or into a folder
; that holds it, would delete the dump before copying it.
Function CheckInstDir
  StrCpy $0 "$INSTDIR\"
  StrCpy $1 "$EXEDIR\"
  StrLen $2 $0
  StrCpy $3 $1 $2
  ${If} $3 == $0
    MessageBox MB_ICONSTOP "Choose another install folder: $INSTDIR holds this setup program's game_files, which installing would delete." /SD IDOK
    Abort
  ${EndIf}
FunctionEnd

Function DirLeave
  Call CheckInstDir
FunctionEnd

; MUI's text label is 60u tall even with TEXT_LARGE, and a long version,
; install folder and saves path need about twice that: the rest was cut.
; The label grows to 113u, which ends the Play checkbox (moved below it,
; the same gap apart) at 173u of the 193u page. Scaled from the label's
; own pixel size rather than mapped from dialog units: this page's units
; are not the ones MapDialogRect gives for it, and scaling holds at any
; display scaling.
Function FinishShow
  System::Call "*(i, i, i, i) p .r0"
  System::Call "user32::GetWindowRect(p $mui.FinishPage.Text, p r0)"
  System::Call "user32::MapWindowPoints(p 0, p $mui.FinishPage, p r0, i 2)"
  System::Call "*$0(i .r1, i .r2, i .r3, i .r4)"
  System::Call "user32::GetWindowRect(p $mui.FinishPage.Run, p r0)"
  System::Call "user32::MapWindowPoints(p 0, p $mui.FinishPage, p r0, i 2)"
  System::Call "*$0(i .r5, i .r6, i .r7, i .r8)"
  System::Free $0
  ; $3 width, $4 height (60u), $6 the gap, $7 and $8 the checkbox's size.
  IntOp $3 $3 - $1
  IntOp $7 $7 - $5
  IntOp $8 $8 - $6
  IntOp $6 $6 - $4
  IntOp $4 $4 - $2
  IntOp $4 $4 * 113
  IntOp $4 $4 / 60
  System::Call "user32::SetWindowPos(p $mui.FinishPage.Text, p 0, i r1, i r2, i r3, i r4, i 0x14)"
  IntOp $6 $6 + $2
  IntOp $6 $6 + $4
  System::Call "user32::SetWindowPos(p $mui.FinishPage.Run, p 0, i r5, i r6, i r7, i r8, i 0x14)"
FunctionEnd

Section "@NAME@" SecMain
  SectionIn RO
  ; The game files are copied from beside setup at install time, not
  ; packed, so NSIS cannot see them: count them in "Space required".
  AddSize @GAME_FILES_KB@
  SetOutPath "$INSTDIR"
  ; The stub lands as .stub: apply.exe puts it in place once current.txt
  ; names a version it can run.
  File "/oname=apply.exe" "@APPLY@"
  File "/oname=@APP@.exe.stub" "@STUB@"
  DetailPrint "apply.exe migrate"
  nsExec::ExecToLog '"$INSTDIR\apply.exe" migrate --root "$INSTDIR"'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_ICONSTOP "Preparing $INSTDIR failed (apply.exe migrate: $0); see the details. Nothing of this version was installed." /SD IDOK
    Abort
  ${EndIf}
  ; An in-place install's files that no SHA256SUMS named (older versions'
  ; extras): the migration leaves them, so they go here.
  Delete "$INSTDIR\enhance\hud.pack"
  RMDir "$INSTDIR\enhance"
  Delete "$INSTDIR\config.seed.toml"
  RMDir /r "${PART}"
@INSTALL_FILES@
  ; The options chosen in the build wizard (package --seed-config) become
  ; the data folder's config\config.toml only when there is none yet: the
  ; player's own file is never replaced, and a later install leaves it. An
  ; earlier version's config\enhance.toml counts as the player's file too:
  ; the game renames it to config.toml only while config.toml is missing.
  IfFileExists "${PART}\config.seed.toml" 0 seed_done
  IfFileExists "$LOCALAPPDATA\@DATA_DIR@\config\config.toml" seed_done 0
  IfFileExists "$LOCALAPPDATA\@DATA_DIR@\config\enhance.toml" 0 seed_copy
    DetailPrint "Kept your existing settings: $LOCALAPPDATA\@DATA_DIR@\config\enhance.toml"
    Goto seed_done
  seed_copy:
    CreateDirectory "$LOCALAPPDATA\@DATA_DIR@\config"
    CopyFiles /SILENT "${PART}\config.seed.toml" "$LOCALAPPDATA\@DATA_DIR@\config\config.toml"
    DetailPrint "Your options: $LOCALAPPDATA\@DATA_DIR@\config\config.toml"
  seed_done:
  ; Versions before config.default.toml shipped enhance.toml.default; an
  ; install over one would keep it, and uninstall's RMDir would then fail.
  Delete "$INSTDIR\enhance.toml.default"
  ; The dump: replaced on every install, the same way every version.
  RMDir /r "$INSTDIR\game_files"
  CreateDirectory "$INSTDIR\game_files"
  CopyFiles /SILENT "$EXEDIR\game_files\*.*" "$INSTDIR\game_files"
  IfFileExists "$INSTDIR\game_files\default.xbe" +3
    MessageBox MB_ICONSTOP "Copying the game files failed (disk full?)." /SD IDOK
    Abort
  ; Checked against its SHA256SUMS, flushed, then current.txt in one move.
  DetailPrint "apply.exe switch @VERSION@"
  nsExec::ExecToLog '"$INSTDIR\apply.exe" switch "@VERSION@" --root "$INSTDIR"'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_ICONSTOP "Installing version @VERSION@ failed (apply.exe switch: $0); see the details. The version installed before stays current." /SD IDOK
    Abort
  ${EndIf}
  WriteUninstaller "$INSTDIR\uninstall.exe"
  WriteRegStr HKCU "Software\@APP@" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "@NAME@"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "@VERSION@"
  WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "your own build"
  WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\@APP@.exe,0"
  WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKCU "${UNINST_KEY}" "QuietUninstallString" '"$INSTDIR\uninstall.exe" /S'
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1
  CreateDirectory "$SMPROGRAMS\@APP@"
  CreateShortcut "$SMPROGRAMS\@APP@\@LINK_NAME@.lnk" "$INSTDIR\@APP@.exe" "" "$INSTDIR\@APP@.exe" 0
SectionEnd

Section /o "Desktop shortcut" SecDesktop
  CreateShortcut "$DESKTOP\@LINK_NAME@.lnk" "$INSTDIR\@APP@.exe" "" "$INSTDIR\@APP@.exe" 0
SectionEnd

Section "Uninstall"
  ; Only what the installer wrote. The data folder (saves, settings, logs)
  ; is never touched. A migrated version's game_files is a junction to
  ; the root's: a plain RMDir removes the link itself, and goes first so
  ; that the recursive delete of versions\ never walks through one.
  FindFirst $0 $1 "$INSTDIR\versions\*"
  ${DoWhile} $1 != ""
    ${If} $1 != "."
    ${AndIf} $1 != ".."
      RMDir "$INSTDIR\versions\$1\game_files"
    ${EndIf}
    FindNext $0 $1
  ${Loop}
  FindClose $0
  RMDir /r "$INSTDIR\versions"
  Delete "$INSTDIR\current.txt"
  Delete "$INSTDIR\current.txt.tmp"
  Delete "$INSTDIR\@APP@.exe.stub"
  Delete "$INSTDIR\apply.exe"
  Delete "$INSTDIR\apply.exe.tmp"
  RMDir /r "$INSTDIR\state"
  ; An in-place install's files, by name (an interrupted migration).
@UNINSTALL_FILES@
  Delete "$INSTDIR\enhance.toml.default"
  Delete "$INSTDIR\config.seed.toml"
  Delete "$INSTDIR\enhance\hud.pack"
  RMDir "$INSTDIR\enhance"
  Delete "$INSTDIR\uninstall.exe"
  RMDir /r "$INSTDIR\game_files"
  RMDir "$INSTDIR"
  Delete "$SMPROGRAMS\@APP@\@LINK_NAME@.lnk"
  RMDir "$SMPROGRAMS\@APP@"
  Delete "$DESKTOP\@LINK_NAME@.lnk"
  DeleteRegKey HKCU "${UNINST_KEY}"
  DeleteRegKey HKCU "Software\@APP@"
  DetailPrint "Your saves and settings were kept in $LOCALAPPDATA\@DATA_DIR@."
SectionEnd
